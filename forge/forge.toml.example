# Forge Configuration File
# Copy this to one of the following locations and fill in your credentials:
#   - ./.forge.toml (current directory)
#   - ~/.config/forge.toml
#   - ~/.forge.toml

# Your Forgejo username
username = "your-username"

# Your Forgejo API token
token = "your-api-token"

# Forgejo HTTPS API host (optional, defaults to git.rust-bitcoin.org)
# https_host = "git.rust-bitcoin.org"

# Forgejo SSH host for git fetch/push operations (optional, defaults to git-ssh.rust-bitcoin.org)
# ssh_host = "git-ssh.rust-bitcoin.org"
