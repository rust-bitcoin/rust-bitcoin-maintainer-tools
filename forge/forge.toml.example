# Forge Configuration File
# Copy this to one of the following locations and fill in your credentials:
#   - ./.forge.toml (current directory)
#   - ~/.config/forge.toml
#   - ~/.forge.toml

# Your Forgejo username
username = "your-username"

# Your Forgejo API token
token = "your-api-token"

# HTTPS base URL for the Forgejo instance (optional, defaults to https://git.rust-bitcoin.org)
# https_url = "https://git.rust-bitcoin.org"

# SSH hostname for git operations (optional, defaults to git-ssh.rust-bitcoin.org)
# ssh_url = "git-ssh.rust-bitcoin.org"
